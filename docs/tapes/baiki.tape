# Байки.
Output docs/gifs/baiki.gif
Set Shell "bash"
Set FontSize 15
Set Width 960
Set Height 540
Set Padding 14
Set Framerate 20
Set TypingSpeed 40ms
Set Theme "Dracula"
Set CursorBlink false

Set Height 380
Hide
Type ". docs/tapes/demo.sh" Enter
Show

Type "balanda travit --zerno 11" Sleep 300ms Enter
Sleep 3500ms
Type "balanda travit --tema db --zerno 1" Sleep 300ms Enter
Sleep 4s
