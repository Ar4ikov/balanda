# Объедки: найти и сварить мусор.
Output docs/gifs/obedki.gif
Set Shell "bash"
Set FontSize 15
Set Width 960
Set Height 540
Set Padding 14
Set Framerate 20
Set TypingSpeed 40ms
Set Theme "Dracula"
Set CursorBlink false

Hide
Type ". docs/tapes/demo.sh" Enter
Show

Type "balanda scan proekty" Sleep 300ms Enter
Sleep 3500ms
Type "clear" Enter
Type "balanda svarit proekty" Sleep 300ms Enter
Sleep 2s
Type "д" Sleep 500ms Enter
Sleep 3s
