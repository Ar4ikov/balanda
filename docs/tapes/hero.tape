# Короткий тур по четырём частям balanda.
Output docs/gifs/hero.gif
Set Shell "bash"
Set FontSize 15
Set Width 960
Set Height 540
Set Padding 14
Set Framerate 20
Set TypingSpeed 40ms
Set Theme "Dracula"
Set CursorBlink false

Hide
Type ". docs/tapes/demo.sh" Enter
Show

Type "balanda sadit --paika mem=256m,time=2s -- sleep 30" Sleep 300ms Enter
Sleep 3s
Type "balanda scan proekty" Sleep 300ms Enter
Sleep 3s
Type "clear" Enter
Type "balanda nalit --abzacy 1 --stil korporat --zerno 4" Sleep 300ms Enter
Sleep 3s
Type "balanda travit --tema deploy --zerno 2" Sleep 300ms Enter
Sleep 4s
