# Вода: налить и измерить.
Output docs/gifs/voda.gif
Set Shell "bash"
Set FontSize 15
Set Width 960
Set Height 540
Set Padding 14
Set Framerate 20
Set TypingSpeed 40ms
Set Theme "Dracula"
Set CursorBlink false

Set Height 600
Hide
Type ". docs/tapes/demo.sh" Enter
Show

Type "balanda nalit --abzacy 1 --stil gosuslugi --zerno 3" Sleep 300ms Enter
Sleep 3500ms
Type "clear" Enter
Type "balanda nalit -a 1 -s nauka --zerno 5 > vvedenie.txt" Sleep 300ms Enter
Type "balanda proba vvedenie.txt" Sleep 300ms Enter
Sleep 5s
